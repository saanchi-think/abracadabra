        "mode": "runOnceForEachItem",
        "jsCode": "\nconst doc = $json;\nconst client = $('Fetch Clients').item.json;\nconst isTranscript = /notes by gemini/i.test(doc.name || '');\nreturn { json: { keep: isTranscript, doc_id: doc.id, doc_name: doc.name, client_id: client.id, client_name: client.name } };\n"
